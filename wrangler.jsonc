// Cloudflare Worker that serves the static site (Workers Builds runs `npx wrangler deploy` on every push).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "q",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    // /privacy → privacy.html, unknown paths → 404.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
